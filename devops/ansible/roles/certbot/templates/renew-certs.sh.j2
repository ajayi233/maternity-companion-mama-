#!/bin/bash

# SSL Certificate Renewal Script for MAMA App
# This script is called by cron every 2 months

set -e

APP_DIR="{{ app_directory }}"
DOMAIN="{{ app_domain }}"
EMAIL="{{ certbot_email }}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log() {
    echo -e "${GREEN}[$(date +'%Y-%m-%d %H:%M:%S')] $1${NC}"
}

error() {
    echo -e "${RED}[$(date +'%Y-%m-%d %H:%M:%S')] ERROR: $1${NC}"
}

warning() {
    echo -e "${YELLOW}[$(date +'%Y-%m-%d %H:%M:%S')] WARNING: $1${NC}"
}

log "Starting SSL certificate renewal for $DOMAIN"

# Check if certificate needs renewal
if certbot certificates | grep -q "$DOMAIN"; then
    log "Certificate found for $DOMAIN, checking expiration..."
    
    # Renew certificate
    certbot renew --webroot --webroot-path="$APP_DIR/webroot" --quiet
    
    # Check if renewal was successful
    if [ $? -eq 0 ]; then
        log "Certificate renewed successfully"
        
        # Reload nginx to use new certificate
        systemctl reload nginx
        log "Nginx reloaded with new certificate"
        
        # Restart backend if running with Docker Compose
        if [ -f "$APP_DIR/docker-compose.yml" ]; then
            cd "$APP_DIR"
            docker-compose restart backend || warning "Failed to restart backend container"
        fi
        
        log "SSL certificate renewal completed successfully"
    else
        error "Certificate renewal failed"
        exit 1
    fi
else
    warning "No certificate found for $DOMAIN, creating new certificate..."
    
    # Create new certificate
    certbot certonly \
        --webroot \
        --webroot-path="$APP_DIR/webroot" \
        --email "$EMAIL" \
        --agree-tos \
        --no-eff-email \
        --non-interactive \
        -d "$DOMAIN"
    
    if [ $? -eq 0 ]; then
        log "New certificate created successfully"
        systemctl reload nginx
    else
        error "Failed to create new certificate"
        exit 1
    fi
fi

log "SSL certificate renewal process completed at $(date)"
