#!/bin/bash

# MAMA App Startup Script
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

set -e

APP_DIR="{{ app_directory }}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log() {
    echo -e "${GREEN}[$(date +'%Y-%m-%d %H:%M:%S')] $1${NC}"
}

error() {
    echo -e "${RED}[$(date +'%Y-%m-%d %H:%M:%S')] ERROR: $1${NC}"
}

warning() {
    echo -e "${YELLOW}[$(date +'%Y-%m-%d %H:%M:%S')] WARNING: $1${NC}"
}

cd $APP_DIR

log "Starting MAMA App deployment..."

# Fetch latest secrets
log "Fetching secrets from Parameter Store..."
./fetch-secrets.sh

# Load secrets into environment
if [ -f "secrets.env" ]; then
    export $(cat secrets.env | xargs)
    log "Secrets loaded successfully"
else
    warning "No secrets file found"
fi

# Pull latest Docker image
log "Pulling latest Docker image..."
docker-compose pull backend

# Start services
log "Starting application services..."
docker-compose up -d

# Wait for backend to be ready
log "Waiting for backend to be ready..."
for i in {1..30}; do
    if curl -s --connect-timeout 5 "http://localhost:5000/health" > /dev/null 2>&1; then
        log "Backend is ready!"
        break
    fi
    if [ $i -eq 30 ]; then
        error "Backend failed to start within 60 seconds"
        exit 1
    fi
    sleep 2
done

# Check application status
log "Checking application status..."
docker-compose ps

log "MAMA App startup completed successfully!"
log "Application should be available at: https://{{ app_domain }}"
