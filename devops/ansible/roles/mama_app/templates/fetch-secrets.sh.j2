#!/bin/bash

# Fetch secrets from Parameter Store and create environment file
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

SECRETS_FILE="{{ app_directory }}/secrets.env"

# Clear existing secrets file
> $SECRETS_FILE

# Fetch secrets
for secret in mongodb-uri jwt-secret jwt-refresh-secret mnotify-api-key serpapi-key; do
    value=$(aws ssm get-parameter --name "/{{ project_name }}/{{ app_environment_name }}/backend/$secret" --with-decryption --region {{ aws_region }} --query 'Parameter.Value' --output text 2>/dev/null || echo "")
    if [ ! -z "$value" ]; then
        env_name=$(echo $secret | tr '[:lower:]' '[:upper:]' | tr '-' '_')
        echo "${env_name}=${value}" >> $SECRETS_FILE
    fi
done

# Fetch configuration values
for config in jwt-expires-in jwt-refresh-expires-in bcrypt-rounds rate-limit-window-ms rate-limit-max-requests api-rate-limit mnotify-sender-id mnotify-base-url sms-simulation-mode cors-origin password-reset-expires-minutes cookie-expires-in default-location; do
    value=$(aws ssm get-parameter --name "/{{ project_name }}/{{ app_environment_name }}/backend/$config" --region {{ aws_region }} --query 'Parameter.Value' --output text 2>/dev/null || echo "")
    if [ ! -z "$value" ]; then
        env_name=$(echo $config | tr '[:lower:]' '[:upper:]' | tr '-' '_')
        echo "${env_name}=${value}" >> $SECRETS_FILE
    fi
done

echo "Secrets fetched successfully for {{ project_name }}-{{ app_environment_name }}"
