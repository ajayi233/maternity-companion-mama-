# MAMA - Maternal Health Companion Environment Variables

# Application Configuration
VITE_APP_NAME=MAMA
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION="AI-powered maternal health companion for Ghana"

# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_VERSION=v1

# Maps API (for clinic locator)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Environment
NODE_ENV=production