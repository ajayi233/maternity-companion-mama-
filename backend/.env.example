# MAMA Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/mama-health

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# SMS Service (Mnotify)
MNOTIFY_API_KEY=your_mnotify_api_key
MNOTIFY_SENDER_ID=MAMA
MNOTIFY_BASE_URL=https://api.mnotify.com/api

# CORS
CORS_ORIGIN=http://localhost:5173

# Password Reset
PASSWORD_RESET_EXPIRES_MINUTES=10